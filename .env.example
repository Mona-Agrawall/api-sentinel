# --- LLM (Groq) -------------------------------------------------------------
# Leave GROQ_API_KEY empty to run with deterministic rule-based cases only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_ENABLED=true
LLM_TIMEOUT_S=30
LLM_MAX_CASES_PER_ENDPOINT=12

# --- Storage ----------------------------------------------------------------
# Use mongomock://local for an in-memory store (no MongoDB needed, data is lost on exit).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=api_sentinel

# --- Safety -----------------------------------------------------------------
# Hosts that spec_url and base_url may point at. Generated tests are only ever
# sent to the run's base_url, and only if its host is in this list.
TARGET_ALLOWLIST=localhost,127.0.0.1,target_api

# --- Runner -----------------------------------------------------------------
REQUEST_TIMEOUT_S=10
FUNCTIONAL_CONCURRENCY=10
MAX_CASES_PER_ENDPOINT=60
MAX_USERS=200
MAX_DURATION_S=600
# Load tests only hit GET/HEAD endpoints unless this is true.
LOAD_INCLUDE_UNSAFE_METHODS=false

# --- Regression detection -----------------------------------------------------
REGRESSION_BASELINE_RUNS=5
REGRESSION_PCT_THRESHOLD=20
REGRESSION_MS_THRESHOLD=50

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
